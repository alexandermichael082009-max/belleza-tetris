{
  "name": "belleza-tetris-desktop",
  "version": "1.0.0",
  "description": "Belleza Tetris como aplicación de escritorio (Electron)",
  "main": "main.js",
  "author": "Michael y Jocabeth",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.belleza.bellezatetris",
    "productName": "Belleza Tetris",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**"
        ]
      },
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/*.log"
        ]
      }
    ],
    "win": {
      "target": "dir"
    },
    "directories": {
      "output": "dist"
    }
  }
}