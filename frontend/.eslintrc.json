{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "SpeechSynthesisUtterance": "readonly"
  },
  "rules": {
    "max-lines": ["warn", { "max": 300 }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  }
}